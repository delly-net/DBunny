<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- 多目标框架：Standard2.0 + .NET5 + .NET8(AOT) -->
		<TargetFrameworks>netstandard2.0;net5.0;net8.0</TargetFrameworks>
		<Version>2026.5.6</Version>
		<Authors>Delly.Net</Authors>
		<Description>Microsoft Access provider for Delly.DBunny (supports both .accdb and .mdb formats)</Description>
		<PackageIcon>Bunny_128.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<!-- Suppress TFM support warning for net5.0 -->
		<SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
		<PackageTags>db database access sql data provider oledb msaccess mdb accdb dbunny netstandard dotnet dotnet5 dotnet8 aot</PackageTags>
		<RepositoryUrl>https://github.com/delly-net/DBunny</RepositoryUrl>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
	</PropertyGroup>

	<!-- 仅给支持的框架开启 Nullable -->
	<PropertyGroup Condition="'$(TargetFramework)'!='netstandard2.0'">
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<!-- 仅对 net8.0 开启 -->
	<PropertyGroup Condition="'$(TargetFramework)'=='net8.0'">
		<IsAotCompatible>true</IsAotCompatible>
		<PublishAotCompilationEnabled>true</PublishAotCompilationEnabled>
		<AllowUnsafeBlocks>false</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Delly.DBunny.Core\Delly.DBunny.Core.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)'=='netstandard2.0'">
		<PackageReference Include="System.Data.OleDb" Version="8.0.0" />
	</ItemGroup>

	<!-- For .NET 5.0 and .NET 8.0 on Windows only -->
	<ItemGroup Condition="'$(TargetFramework)'!='netstandard2.0'">
		<PackageReference Include="System.Data.OleDb" Version="8.0.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\Document\Logo\Bunny_128.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

</Project>